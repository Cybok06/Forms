{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Forms app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "FLASK_DEBUG": "1"
      }
    }
  ]
}
